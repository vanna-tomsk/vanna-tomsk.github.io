<header class="top">
  <div class="top-in">
    <a class="logo" href="/" aria-label="{{ site.name }} — на главную"><b>ВАННА+</b><span>реставрация ванн · Томск</span></a>
    <nav class="nav" id="nav" aria-label="Основное меню">
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="top-cta">
      <a class="top-phone" href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      <button class="btn btn-dark btn-sm js-open-lead" type="button">Записаться</button>
    </div>
    <button class="burger" type="button" aria-controls="nav" aria-expanded="false" aria-label="Меню"><span></span><span></span></button>
  </div>
</header>
